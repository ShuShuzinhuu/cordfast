msgstr "Version {version} ist bereit."

#: src\ui\settings.rs:1564
msgid "Restart and Update"
msgstr "Neu starten und aktualisieren"

#: src\ui\settings.rs:1567
msgid "Version {version} is out, but this copy does not update itself."
msgstr "Version {version} ist erschienen, aber diese Kopie aktualisiert sich nicht selbst."

#: src\ui\settings.rs:1568
msgid "Download on GitHub"
msgstr "Auf GitHub herunterladen"

#: src\ui\settings.rs:1573
msgid "The update failed: {error}"
msgstr "Das Update ist fehlgeschlagen: {error}"

#: src\ui\settings.rs:1580
msgid "Third-party clients break Discord's terms of service. Use at your own risk."
msgstr "Clients von Drittanbietern verstoßen gegen die Nutzungsbedingungen von Discord. Nutzung auf eigene Gefahr."


#: src\ui\settings.rs:1349
msgid "Automatically open Discord when your computer starts up"
msgstr "Abrir Discord automáticamente al arrancar el ordenador"

#: src\ui\settings.rs:1351
msgid "Start Discord minimized"
msgstr "Iniciar Discord minimizado"

#: src\ui\settings.rs:1351

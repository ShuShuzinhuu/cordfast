msgid "About CordFast"
msgstr "Informazioni su CordFast"

#: src\ui\settings.rs:1300
msgid "A native, light and fast Discord."
msgstr "Un Discord nativo, leggero e veloce."

#: src\ui\settings.rs:1303
msgid "You're on the latest version."
msgstr "Hai la versione più recente."

#: src\ui\settings.rs:1304

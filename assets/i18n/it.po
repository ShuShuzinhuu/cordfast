msgstr "Download della versione {version}… {percent}%"

#: src\ui\settings.rs:1306
msgid "Version {version} is ready."
msgstr "La versione {version} è pronta."

#: src\ui\settings.rs:1308
msgid "Restart and Update"
msgstr "Riavvia e aggiorna"

#: src\ui\settings.rs:1311
msgid "Version {version} is out, but this copy does not update itself."
msgstr "È uscita la versione {version}, ma questa copia non si aggiorna da sola."

#: src\ui\settings.rs:1312
msgid "Download on GitHub"
msgstr "Scarica da GitHub"

#: src\ui\settings.rs:1317
msgid "The update failed: {error}"
msgstr "L'aggiornamento non è riuscito: {error}"

#: src\ui\settings.rs:1324
msgid "Third-party clients break Discord's terms of service. Use at your own risk."
msgstr "I client di terze parti violano i termini di servizio di Discord. Usalo a tuo rischio."

